{
  "color": {
    "black": "#0A0A0A",
    "black-900": "#111111",
    "black-800": "#1C1C1C",
    "black-700": "#2B2B2B",
    "yellow-700": "#8F6C00",
    "yellow-500": "#F5C21B",
    "yellow-300": "#FFD54A",
    "white-0": "#FFFFFF",
    "gray-50": "#F4F4F4",
    "line": "#E2E2E2",
    "ink-900": "#0A0A0A",
    "ink-600": "#555555",
    "white": "#FFFFFF",
    "black-a66": "rgba(0, 0, 0, 0.66)"
  },
  "font": {
    "display": "Cormorant Garamond",
    "body": "DM Sans",
    "caps": "Oswald",
    "bodySerif": "EB Garamond"
  },
  "type": {
    "display-xl": {
      "family": "display",
      "weight": 600,
      "size": 96,
      "lineHeight": 1.0,
      "letterSpacing": "-0.01em"
    },
    "display-l": {
      "family": "display",
      "weight": 600,
      "size": 60,
      "lineHeight": 1.1,
      "letterSpacing": "-0.005em"
    },
    "heading-m": {
      "family": "display",
      "weight": 600,
      "size": 38,
      "lineHeight": 1.15
    },
    "heading-s": {
      "family": "display",
      "weight": 700,
      "size": 26,
      "lineHeight": 1.2
    },
    "quote": {
      "family": "display",
      "weight": 500,
      "style": "italic",
      "size": 32,
      "lineHeight": 1.3
    },
    "stat": {
      "family": "display",
      "weight": 600,
      "size": 64,
      "lineHeight": 1.0
    },
    "eyebrow": {
      "family": "body",
      "weight": 600,
      "size": 13,
      "lineHeight": 1.4,
      "letterSpacing": "0.18em",
      "textTransform": "uppercase"
    },
    "body-l": {
      "family": "body",
      "weight": 400,
      "size": 19,
      "lineHeight": 1.6
    },
    "body-m": {
      "family": "body",
      "weight": 400,
      "size": 16,
      "lineHeight": 1.6
    },
    "body-s": {
      "family": "body",
      "weight": 400,
      "size": 14,
      "lineHeight": 1.5
    },
    "label": {
      "family": "body",
      "weight": 600,
      "size": 15,
      "lineHeight": 1.2,
      "letterSpacing": "0.01em"
    },
    "nav": {
      "family": "caps",
      "weight": 400,
      "size": 15,
      "lineHeight": 1.2,
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    },
    "button": {
      "family": "caps",
      "weight": 400,
      "size": 17,
      "lineHeight": 1.2,
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    },
    "hero-eyebrow": {
      "family": "display",
      "weight": 700,
      "size": 24,
      "lineHeight": 1.2,
      "letterSpacing": "0.03em",
      "textTransform": "uppercase"
    },
    "hero-title": {
      "family": "display",
      "weight": 700,
      "size": 72,
      "lineHeight": 1.05,
      "letterSpacing": "-0.005em"
    },
    "hero-meta": {
      "family": "display",
      "weight": 600,
      "size": 24,
      "lineHeight": 1.3
    },
    "hero-tagline": {
      "family": "display",
      "weight": 600,
      "size": 22,
      "lineHeight": 1.45
    },
    "body-serif": {
      "family": "bodySerif",
      "weight": 400,
      "size": 20,
      "lineHeight": 1.7
    }
  },
  "hero": {
    "image": "public/images/hero-slohs.png",
    "overlay": "black-a66",
    "height": 900,
    "textShadow": "0 2px 12px rgba(0, 0, 0, 0.35)"
  },
  "logo": "public/images/crest.png",
  "layout": {
    "maxWidth": 1440,
    "gutter": 80,
    "contentWidth": 1280,
    "sectionPaddingY": 120,
    "gridGap": 32,
    "radius": 2
  },
  "notes": "Mostly white with SLO High yellow accents. Yellow text only on dark; use ink on white. No em dashes in copy."
}
